<?xml version="1.0"?>
<package format="3">
  <name>camera_bringup</name>
  <version>0.1.0</version>
  <description>Bringup for fisheye and RealSense cameras via manager run launches.</description>
  <maintainer email="support@agilex.ai">AgileX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fisheye_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
