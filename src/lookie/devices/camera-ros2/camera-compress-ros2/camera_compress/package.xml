<?xml version="1.0"?>
<package format="3">
  <name>camera_compress</name>
  <version>0.1.0</version>
  <description>Camera image compression package with C++ and Python script support.</description>
  <maintainer email="support@agilex.ai">AgileX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>libgstreamer-plugins-base1.0-dev</depend>
  <depend>libgstreamer1.0-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <exec_depend>gstreamer1.0-vaapi</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
