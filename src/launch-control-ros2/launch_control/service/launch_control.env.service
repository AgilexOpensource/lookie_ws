[Unit]
Description=ROS 2 Launch Control
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
# StartLimitBurst=5

[Service]
Type=simple
# Default workspace; override with /etc/default/launch_control (optional):
#   LAUNCH_CONTROL_WS=/home/agilex/other_ws
#   # HOME=/home/agilex
#   USER=agilex
User=agilex
# Group=agilex
Environment=LAUNCH_CONTROL_WS=/home/agilex/develop/launch_control/launch_control_ws
# Environment=HOME=/home/agilex
# Environment=USER=agilex
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/launch_control
# Source overlay first so run.sh sees launch_control and skips ~/ros2_ws.
ExecStart=/bin/bash -lc 'source "${LAUNCH_CONTROL_WS}/install/setup.bash" && exec "${LAUNCH_CONTROL_WS}/install/launch_control/lib/launch_control/run.sh"'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
