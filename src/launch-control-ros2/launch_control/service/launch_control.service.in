# Generated by CMake; legacy service files are preserved separately.
[Unit]
Description=ROS 2 Launch Control
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@LAUNCH_CONTROL_SERVICE_USER@
WorkingDirectory=~
Environment=PYTHONUNBUFFERED=1
# Optional runtime settings, including existing lowercase home/user overrides.
# LAUNCH_CONTROL_WS does not change the compiled entry point or setup path.
EnvironmentFile=-/etc/default/launch_control
ExecStart="@CMAKE_INSTALL_PREFIX@/lib/launch_control/run.sh"
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
