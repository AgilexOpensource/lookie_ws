<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>launch_control</name>
  <version>0.1.0</version>
  <description>Standalone ROS 2 launch process manager</description>
  <maintainer email="agilex@todo.todo">agilex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <depend>launch_control_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-psutil</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
