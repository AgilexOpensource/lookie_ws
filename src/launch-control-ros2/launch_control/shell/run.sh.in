#!/bin/bash
# Usage examples (run the installed script):
#   ./run.sh                         # Default: ros2 run launch_control launch_control.py
#   ./run.sh run                     # Explicit ros2 run mode
#   ./run.sh run --ros-args -r __node:=launch_control_node
#   ./run.sh launch                  # ros2 launch launch_control launch_control.launch.py
#   ./run.sh launch --show-args       # Show launch arguments without starting nodes
# Arguments after run/launch are forwarded unchanged to the selected ROS command.
# Generated by CMake. Edit shell/run.sh.in, then rebuild.

# BEGIN previous lowercase defaults (kept for comparison)
# # Keep explicit lowercase overrides used by the existing Python node.
# if [[ ! -v user ]]; then
#     user="$(id -un)" || exit 1
# fi
# if [[ ! -v home ]]; then
#     home="$(getent passwd "$(id -u)" | cut -d: -f6)"
#     if [[ -z "$home" ]]; then
#         echo "error: cannot determine runtime user's home" >&2
#         exit 1
#     fi
# fi
# export user home
# END previous lowercase defaults

# Leave USER/HOME and optional legacy user/home to the Python node.

setup_file="@LAUNCH_CONTROL_SETUP@"
if [[ ! -f "$setup_file" ]]; then
    echo "error: workspace setup not found: $setup_file; rebuild after moving the workspace" >&2
    exit 1
fi
# Always load this deployment, even if another launch_control is already sourced.
# shellcheck disable=SC1090
source "$setup_file" || exit 1
source ~/source.bash || exit 1
# Resolve through ROS for both entry points; reject another deployment.
prefix="$(ros2 pkg prefix launch_control)" || exit 1
if [[ "$(readlink -f "$prefix")" != "$(readlink -f "@CMAKE_INSTALL_PREFIX@")" ]]; then
    echo "error: launch_control resolves to $prefix, expected @CMAKE_INSTALL_PREFIX@" >&2
    exit 1
fi
# No selector means ros2 run. Forward all remaining arguments unchanged.
case "${1:-}" in
    launch)
        shift
        exec ros2 launch launch_control launch_control.launch.py "$@"
        ;;
    run)
        shift
        exec ros2 run launch_control launch_control.py "$@"
        ;;
    *)
        exec ros2 run launch_control launch_control.py "$@"
        ;;
esac
